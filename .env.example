SIMORGH_ENV=development
SIMORGH_LOG_LEVEL=INFO

# AvalAI model gateway (server only; never put this key in the Android APK)
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_USER_API_BASE_URL=https://api.avalai.ir/user/v1
AVALAI_DEFAULT_MODEL=gpt-5.4-mini

# Android device gateway
# Generate a long random token. The same value is entered into the private Android app.
SIMORGH_DEVICE_TOKEN=

# API
# Use 0.0.0.0 only on a trusted development network when connecting a physical phone.
SIMORGH_HOST=127.0.0.1
SIMORGH_PORT=8080
