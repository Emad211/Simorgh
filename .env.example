SIMORGH_ENV=development
SIMORGH_LOG_LEVEL=INFO

# AvalAI model gateway
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
AVALAI_USER_API_BASE_URL=https://api.avalai.ir/user/v1
AVALAI_DEFAULT_MODEL=gpt-5.4-mini

# API
SIMORGH_HOST=127.0.0.1
SIMORGH_PORT=8080

# Durable Core action journal
# Keep this path on a persistent, private filesystem. SQLite creates WAL/SHM sidecar files.
SIMORGH_ACTION_JOURNAL_PATH=.simorgh/action-journal.sqlite3
SIMORGH_ACTION_JOURNAL_MAX_TERMINAL_RECORDS=256

# Device gateway
# Generate separate random values. The operator token authorizes action dispatch;
# the device token authorizes only the Android WebSocket.
SIMORGH_DEVICE_TOKEN=
SIMORGH_OPERATOR_TOKEN=
